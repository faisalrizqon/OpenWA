# GoPay Merchant Gateway Configuration
# Copy this to your project root or VPS as .env file

PORT=3100                      # Port gateway (3000 dipakai Next.js)
GOPAY_GATEWAY_URL=http://localhost:3100  # URL accessible from main app
GOPAY_API_KEY="generate_random_secure_key_here"   # Min 32 chars alphanumeric

# QRIS statis dari dashboard GoPay Merchant (wajib diisi setelah login OTP)
QRIS_STATIC=""                # Empty = auto discovered via API after login

# Merchant ID GoPay (opsional: kosongkan untuk auto-discover)
GOPAY_MERCHANT_ID=""          # Auto-populate from session after login

# Note: Login OTP dilakukan SEKALI via terminal (`node login.js`).
# Session tersimpan otomatis & token auto-refresh tiap 6 jam.
# Jangan commit file ini ke Git — tambahkan ke .gitignore.
