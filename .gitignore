# Dependencies
/node_modules/
.pnp*
.yarn/

# Testing
/coverage/

# Next.js build outputs
/.next/
/out/
build/
dist/

# Environment files (keep .env.example committed, but never real secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!ecosystem.config.js.backup  # backup config is OK to commit with dummy keys

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database files - exclude WAL and shm, keep main DB tracked
data/*.db-shm
data/*.db-wal
!.env.db

# Typescript build
*.tsbuildinfo

# Generated Prisma client (will regenerate on server)
/src/generated/prisma/

# Uploaded user data (KTP, photos, etc.)
/public/uploads/

# Temporary/build folders
tmp/
test-upload/

# IDE & Editor configs
.vscode/
.idea/
*.swp
*.swo

# System files
.DS_Store
Thumbs.db

# Debugging
.eslintcache

# Deployment artifacts
deploy/*.log
deploy/debug-*.json

# === MudahSewa-specific exclusions ===
# Personal/imported data
notion/
openwa-data/
.hermes/
.test-upload/
dev/
wa-qr.png

# Customer files (KTP, proofs) - never commit
storage/

# All env files (any suffix) except examples
.env*
!.env.example
!gopay-gateway/.env.example
!openwa-server/.env.example
openwa-server/
