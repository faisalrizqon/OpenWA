# Dependencies
/node_modules/
.pnp*
.yarn/

# Testing
/coverage/

# Next.js build outputs
/.next/
/out/
build/
dist/

# Environment files (keep .env.example committed, but never real secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!ecosystem.config.js.backup  # backup config is OK to commit with dummy keys

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Typescript build
*.tsbuildinfo

# Generated Prisma client (will regenerate on server)
/src/generated/prisma/

# Uploaded user data (KTP, photos, etc.)
/public/uploads/

# Temporary/build folders
tmp/
test-upload/

# IDE & Editor configs
.vscode/
.idea/
*.swp
*.swo

# System files
.DS_Store
Thumbs.db

# Debugging
.eslintcache

# Deployment artifacts
deploy/*.log
deploy/debug-*.json

# === MudahSewa-specific exclusions ===
# Personal/imported data
notion/
openwa-data/
.hermes/
.test-upload/
dev/
wa-qr.png

# Customer files (KTP, proofs) - never commit
storage/

# All env files (any suffix) except examples
.env*
!.env.example
!gopay-gateway/.env.example
!openwa-server/.env.example
openwa-server/

# Local development plans
.hermes/

# Database & runtime data - jangan commit DB berisi data pelanggan (PII) / secrets
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite-*
data/.api-key
data/plugins/
!data/.gitkeep

# OpenWA deployment mode override (ditulis switcher di /admin/whatsapp — preferensi mesin)
openwa-deployment-mode.json

# OpenWA session backups, update artifacts, and debug scripts — never commit
openwa-data-backup-*
openwa-update-progress.json
openwa-update.lock
scripts/_diag-*.cjs
scripts/_diag-*.ps1
scripts/_kill-session-*.ps1
scripts/openwa-updater.cjs
scripts/openwa-*.ps1
scripts/debug-*.mjs
scripts/verify-openwa-login.mjs

# Local development plans
.hermes/
